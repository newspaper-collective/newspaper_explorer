  owl:annotatedSource :node-186;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-187;
  :comment " Mr. Gaston Thomson, the rapporteur for this commission's deliberations, stated in his report that \"The question of constitutional revision must not be touched prematurely; it will in all likelihood be raised automatically after the war.\"";
  :id "a8741d5a-a227-44f0-8d64-9c0cc53346db";
  :type " MENTIONS";
  :created_by "AI_INGEST" .

