  owl:annotatedSource :node-860;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-887;
  :comment " The decree formalizing the regulation of iron production signifies an increase in state intervention in market mechanisms, moving from a \"de facto arrangement\" to formal law during a period of conflict.";
  :id "9881a51b-8de9-4622-a4f1-5451d8f24c75";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

:rel-1157425104234218332 a owl:Axiom;
  owl:annotatedSource :node-860;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-887;
  :comment " The \"recent decree\" formalizing the de facto arrangement and forbidding private disposal of machine tools indicates the implementation of specific governmental controls during a period of conflict.";
