  :id "7552b88c-5db6-4dba-9a00-36f3b80f32b1";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

:rel-6917529027641084738 a owl:Axiom;
  owl:annotatedSource :node-2839;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-2882;
  :comment " The company's annual result was negatively affected by an unfavorable relationship between raw material prices and finished product prices at the war's outset.";
  :id "6a08a4b5-1cd1-4591-ac8d-7ead8e060b53";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

:rel-6917529027641084742 a owl:Axiom;
  owl:annotatedSource :node-2839;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-2886;
  :comment " Steel production reached 71 percent of the previous year's corresponding period during the last quarter of the business year, averaging 66 percent during the eleven months of war, with further reductions in coal, coke, iron ore, pig iron, and crude steel.";
  :id "47fea391-64c4-4996-9207-013c32420467";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

