  owl:annotatedSource :node-2839;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-2892;
  :comment " Prices for products sold by the Steelworks Association rose during the war, except for track materials for German state railways, which are under multi-year contracts.";
  :id "d20cb1d8-e707-4390-84b2-8f2e4722d295";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

