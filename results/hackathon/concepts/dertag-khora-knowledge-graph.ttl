:rel-6917529027641083449 a owl:Axiom;
  owl:annotatedSource :node-1547;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-1593;
  :comment " widespread celebrations in various Italian cities on the anniversary of Italy's declaration of war, highlighting a strong sense of national identity and support for the war effort among some segments of the population.";
  :id "3469418c-806f-4598-a4c4-42cfb73bcc23";
  :type "CLAIMS";
