  :type "PUBLISHED_IN";
  :created_by "AI_INGEST" .

:rel-6917529027641082624 a owl:Axiom;
  owl:annotatedSource :node-719;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-768;
  :comment " This concept details government teams assessing, requisitioning, and documenting agricultural produce from individual farms, ensuring state control over food supplies.";
  :id "03d32259-78ee-4d1d-b732-83d8c1507b09";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

:rel-6917529027641082628 a owl:Axiom;
  owl:annotatedSource :node-719;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-772;
  :comment " This concept describes how farmers were required to declare all grain, sign protocols, and undergo inspections to ensure accurate reporting and prevent hoarding, indicating a system of accountability.";
  :id "69cf6253-dcf2-4601-9caa-3f706bc9fa39";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

:rel-6917529027641082633 a owl:Axiom;
  owl:annotatedSource :node-719;
  owl:annotatedProperty :LINKS;
  owl:annotatedTarget :node-777;
  :comment " This concept describes the speaker's belief that re-examinations satisfy both the government and farmers, and are seen as superior, suggesting an emphasis on fostering compliance and confidence in state actions.";
  :id "84e47588-60bb-49ae-b151-5b549c417cc0";
  :type "CLAIMS";
  :created_by "AI_INGEST" .

:rel-6917529027641082636 a owl:Axiom;
  owl:annotatedSource :node-719;
  owl:annotatedProperty :LINKS;
