@prefix : <https://www.example.org/> .
@prefix neo4j: <https://neo4j.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-point-type>
  a owl:Class;
  rdfs:label "Point" .

<https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-cartesian>
  a owl:Class;
  rdfs:label "Cartesian Point";
  rdfs:subClassOf <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-point-type> .

<https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-geographic>
  a owl:Class;
  rdfs:label "Geographic Point";
  rdfs:subClassOf <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-point-type> .

<https://spatialreference.org/ref/epsg/4326/> a owl:Class;
  rdfs:label "Geographic Point 2D";
  rdfs:subClassOf <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-geographic> .

<https://spatialreference.org/ref/epsg/4979/> a owl:Class;
  rdfs:label "Geographic Point 3D";
  rdfs:subClassOf <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-geographic> .

<https://neo4j.com/docs/cypher-manual/current/functions/spatial/#functions-point-cartesian-2d>
  a owl:Class;
  rdfs:label "Cartesian Point 2D";
  rdfs:subClassOf <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-cartesian> .

<https://neo4j.com/docs/cypher-manual/current/functions/spatial/#functions-point-cartesian-3d>
  a owl:Class;
  rdfs:label "Cartesian Point 3D";
  rdfs:subClassOf <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-cartesian> .

neo4j:x-coordinate a owl:DatatypeProperty;
  rdfs:label "x-coordinate";
  rdfs:domain <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-point-type> .

neo4j:y-coordinate a owl:DatatypeProperty;
  rdfs:label "y-coordinate";
  rdfs:domain <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-point-type> .

neo4j:z-coordinate a owl:DatatypeProperty;
  rdfs:label "z-coordinate";
  rdfs:domain <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-point-type> .

neo4j:longitude a owl:DatatypeProperty;
  rdfs:label "longitude";
  rdfs:subPropertyOf neo4j:x-coordinate;
  rdfs:domain <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-geographic> .

neo4j:latitude a owl:DatatypeProperty;
  rdfs:label "latitude";
  rdfs:subPropertyOf neo4j:y-coordinate;
  rdfs:domain <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-geographic> .

neo4j:height a owl:DatatypeProperty;
  rdfs:label "height";
  rdfs:subPropertyOf neo4j:z-coordinate;
  rdfs:domain <https://neo4j.com/docs/cypher-manual/current/values-and-types/spatial/#spatial-values-crs-geographic> .

