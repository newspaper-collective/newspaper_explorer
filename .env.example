# Environment Configuration for Newspaper Explorer
# Copy this file to .env and customize as needed

# Data directory settings
DATA_DIR=data
ARCHIVES_DIR=data/archives
EXTRACTED_DIR=data/extracted
PARSED_DIR=data/parsed
PREPROCESSED_DIR=data/preprocessed
SOURCES_DIR=data/sources
RESULTS_DIR=results

# Logging
LOG_LEVEL=INFO

# LLM API Configuration
# Base URL for OpenAI-compatible API endpoint
LLM_BASE_URL=https://api.openai.com/v1

# API authentication key
LLM_API_KEY=your_api_key_here

# Model settings (optional, with defaults)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Data Validation Settings
# Minimum valid image file size in bytes (files smaller are considered corrupt)
MIN_IMAGE_SIZE_BYTES=1024

# Default glob pattern for finding ALTO XML files
DEFAULT_ALTO_PATTERN=**/fulltext/*.xml
